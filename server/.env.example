# DentalFlow AI Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database configuration (SQLite for local zero-dependency development)
DATABASE_URL="file:./dev.db"

# Optional External AI API Key (e.g., Gemini, OpenAI, Claude)
# If left blank, the backend seamlessly uses explainable rule-based heuristics and development fallbacks
AI_API_KEY=
AI_PROVIDER=rule-based
